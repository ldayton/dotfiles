{
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "skipDangerousModePermissionPrompt": true,
    "allow": [
      "Glob",
      "Grep",
      "Read(//**)",
      "Explore(//**)",
      "Task",
      "WebFetch",
      "WebSearch"
    ]
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dippy"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "dippy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dippy"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "dippy"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "dippy-statusline",
    "refreshInterval": 5
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark"
}
