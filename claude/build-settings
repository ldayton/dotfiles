#!/usr/bin/env bash
# Generates ~/.claude/settings.json from the tracked base, an optional private overlay, and
# whatever Claude Code has written into the file itself.
#
# This replaces symlinking the tracked file into place. That arrangement needed a clean filter
# to keep `model` out of commits, and skip-worktree to silence the churn the filter could not
# -- and skip-worktree makes git ignore the file outright, which is how a block of hooks sat
# in the committed config for months after being deleted from disk. Generating instead means
# the file Claude Code writes to is not a file git tracks, so there is nothing to hide.
#
# Same base+local split as CLAUDE.md, zshrc and the gh policy hook. The overlay is private and
# per-machine; it is never created by this repo.

set -euo pipefail

BASE="${CLAUDE_SETTINGS_BASE:-$HOME/source/dotfiles/claude/settings.base.json}"
OVERLAY="${CLAUDE_SETTINGS_OVERLAY:-$HOME/.claude/settings.overlay.json}"
DEST="${CLAUDE_SETTINGS_DEST:-$HOME/.claude/settings.json}"

command -v jq >/dev/null 2>&1 || {
    echo "build-settings: jq is required" >&2
    exit 1
}
[[ -f "$BASE" ]] || {
    echo "build-settings: no base file at $BASE" >&2
    exit 1
}

mkdir -p "$(dirname "$DEST")"

overlay='{}'
if [[ -f "$OVERLAY" ]]; then
    jq -e . "$OVERLAY" >/dev/null 2>&1 || {
        echo "build-settings: $OVERLAY is not valid JSON" >&2
        exit 1
    }
    overlay="$(jq -c . "$OVERLAY")"
fi

# What the app itself has written is carried across, minus anything the base or the overlay
# names. Ownership by exclusion rather than an allowlist of known keys: Claude Code rewrites
# this file wholesale -- key order changes between writes, which is the signature -- so an
# allowlist silently drops every setting it has not heard of, including ones added by a future
# release. Under this rule the repo stays authoritative for what it declares, and anything else
# the app records simply survives.
#
# Ownership is top level. A key the base declares is owned entirely, nested contents included,
# so `permissions` cannot be edited out from under the repo.
carried='{}'
if [[ -f "$DEST" ]]; then
    owned="$(jq -s -c '(.[0] * .[1]) | keys' "$BASE" <(printf '%s' "$overlay"))"
    carried="$(jq -c --argjson owned "$owned" \
        'with_entries(select(.key as $k | $owned | index($k) | not))' "$DEST" 2>/dev/null || echo '{}')"
fi

# Later wins: base, then the private overlay, then the app's unowned keys. Written to a temp
# file in the same directory and renamed, so a failure part-way cannot leave a truncated
# settings file and a concurrent reader never sees one. It also replaces the old symlink on a
# machine that still has it.
tmp="$(mktemp "$(dirname "$DEST")/.settings.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
jq -s --indent 2 '.[0] * .[1] * .[2]' \
    "$BASE" \
    <(printf '%s' "$overlay") \
    <(printf '%s' "$carried") >"$tmp"
# Report whether anything actually changed. Without this every caller has to assume it did:
# the ansible role marked itself changed on every run, and install.sh could not tell a fresh
# generation from a no-op.
if [[ -f "$DEST" ]] && cmp -s "$tmp" "$DEST"; then
    rm -f "$tmp"
    trap - EXIT
    echo unchanged
    exit 0
fi
mv "$tmp" "$DEST"
trap - EXIT
echo updated
