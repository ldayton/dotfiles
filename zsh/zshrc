#--- homebrew setup ---#
# Three prefixes, not two: Apple Silicon, Intel mac, linuxbrew. The old form fell through to
# linuxbrew unconditionally, so an Intel mac errored on every shell and silently lost
# HOMEBREW_PREFIX, MANPATH and /usr/local/sbin -- while `brew` itself kept working off
# /etc/paths, which is what made it easy to miss.
for __brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [[ -x "$__brew" ]]; then
        eval "$("$__brew" shellenv)"
        break
    fi
done
unset __brew

# util-linux is keg-only on macOS (shadowed by the BSD versions), so its GNU column/getopt/
# flock are not linked into the prefix. Without this the Brewfile installs them and nothing
# can find them.
if [[ -n "${HOMEBREW_PREFIX:-}" && -d "$HOMEBREW_PREFIX/opt/util-linux/bin" ]]; then
    export PATH="$HOMEBREW_PREFIX/opt/util-linux/bin:$HOMEBREW_PREFIX/opt/util-linux/sbin:$PATH"
fi

#--- history ---#
HISTFILE=~/.zsh_history    # where to save history
HISTSIZE=1000000000        # number of commands to keep in memory during session
SAVEHIST=1000000000        # number of commands to save to disk
HISTORY_IGNORE="(ll|ls|cd|pwd|exit|history|..|...|....)" # patterns to exclude from history
setopt INC_APPEND_HISTORY  # add commands to history immediately, not on shell exit
setopt EXTENDED_HISTORY    # save timestamp and duration with each command
setopt HIST_IGNORE_DUPS    # don't save command if it's same as the previous one
setopt HIST_IGNORE_SPACE   # don't save commands that start with a space
setopt SHARE_HISTORY       # share history between all terminal sessions in real-time
setopt NO_BEEP             # disable terminal beep sound

#--- completions ---#
autoload -Uz compinit && compinit

#--- rustup environment ---#
if command -v rustup &> /dev/null; then
    rustup_prefix="$(brew --prefix rustup 2>/dev/null)"
    if [[ -n "$rustup_prefix" && -d "$rustup_prefix/bin" ]]; then
        export PATH="$rustup_prefix/bin:$PATH"
    fi
    unset rustup_prefix
fi

#--- java environment ---#
if [[ -d "/Library/Java/JavaVirtualMachines/temurin-25.jdk/Contents/Home" ]]; then
    export JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-25.jdk/Contents/Home
    export PATH=$JAVA_HOME/bin:$PATH
fi

#--- node environment (fnm, auto-switch per .nvmrc) ---#
# Homebrew installs a newer `node` than projects tend to pin via .nvmrc to match their CI/prod.
# fnm reads the nearest .nvmrc on cd + at startup and prepends that node to PATH, so the
# pinned version is used automatically instead of brew's default. (Replaced nvm: ~70ms vs ~1.2s.)
if command -v fnm &> /dev/null; then
    eval "$(fnm env --use-on-cd --version-file-strategy recursive)"
    # `nvm` muscle-memory shim → fnm: the subcommands overlap, so translate the few I still type.
    nvm() {
        case "$1" in
            ls|list) shift; fnm list "$@" ;;
            # the operands are reversed between the two: nvm is name-then-version
            alias) shift; [[ $# -ge 2 ]] && fnm alias "$2" "$1" || fnm alias "$@" ;;
            "") fnm --help ;;
            *) fnm "$@" ;;
        esac
    }
fi

#--- AI assistants ---#
# -U keeps PATH deduplicated, so sourcing this file twice does not compound the prepends below
typeset -U path
export PATH="$HOME/source/dotfiles/gh:$PATH"
export PATH="$HOME/source/dotfiles/claude:$PATH"
export PATH="$HOME/.local/bin:$PATH" # agent (cursor)

#--- shell tools ---#
# ripgrep has no default config path -- it reads one only when pointed at it
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
alias fd="fd --hidden --no-ignore --exclude cdk.out --exclude node_modules --exclude .git --exclude __pycache__ --exclude .venv"
if [[ -x "$HOME/.local/bin/starship" ]]; then
    eval "$($HOME/.local/bin/starship init zsh)"
elif command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
fi

if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

if command -v atuin &> /dev/null; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

#--- wsl ---#
if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    export BROWSER=wslview
    alias open='explorer.exe'
fi

#--- aliases ---#
if command -v eza &> /dev/null; then
    alias ls="eza"
    alias ll="eza -lh"
    alias la="eza -lah"
else
    alias ll="ls -lh"
    alias la="ls -lah"
fi
alias ..="cd .."
alias y="yt-dlp"
alias lg="lazygit"
alias rp="realpath"
mcp-cli() { command mcp-cli "$@" 2>/dev/null; }

# Claude Code wrapper:
# - Builds ~/.claude/CLAUDE.md from ~/source/dotfiles/claude/CLAUDE.base.md + ~/.claude/CLAUDE.local.md
claude() {
    mkdir -p ~/.claude
    # settings.json is generated rather than linked, so the file Claude Code writes into is
    # not one git tracks. build-settings carries `model` across the rebuild.
    build-settings || return 1
    # Build to a temp file and move it into place: `>` truncates before cat runs, so a
    # missing or renamed base file used to leave a zero-byte CLAUDE.md. The mv also makes
    # this safe when two shells start at once.
    local __md
    __md="$(mktemp)" || return 1
    cat ~/source/dotfiles/claude/CLAUDE.base.md > "$__md" || { rm -f "$__md"; return 1; }
    echo >> "$__md"
    cat ~/.claude/CLAUDE.local.md >> "$__md" 2>/dev/null
    mv "$__md" ~/.claude/CLAUDE.md
    command claude \
        --allow-dangerously-skip-permissions  \
        "$@"
}

pypi() { curl -sS "https://pypi.org/pypi/$1/json" | jq -r .info.version; }
promptfoo() { npx promptfoo@latest "$@"; }
cloc() { command cloc --vcs=git "$@"; }

#--- fix key bindings ---#
bindkey -M emacs "^[[H" beginning-of-line     # Home key
bindkey -M emacs "^[[F" end-of-line           # End key
bindkey -M emacs "^[OH" beginning-of-line     # Home key (alternative)
bindkey -M emacs "^[OF" end-of-line           # End key (alternative)
bindkey -M emacs "^[[1~" beginning-of-line    # Home key (another variant)
bindkey -M emacs "^[[4~" end-of-line          # End key (another variant)
bindkey -M emacs "^[[3~" delete-char          # Delete key

#--- local configuration ---#
[[ -f ~/.zshrc.local ]] && . ~/.zshrc.local
command -v direnv &> /dev/null && eval "$(direnv hook zsh)"

# direnv aliases
alias da="direnv allow"
alias dr="direnv reload"
