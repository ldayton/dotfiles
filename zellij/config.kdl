// Locked by default: keystrokes go to whatever is running in the pane, not to zellij.
// Ctrl-g unlocks.
default_mode "locked"

// Only applied to a session with no serialized layout in the cache. zellij restores
// ~/.cache/zellij/*/session_info/<name>/session-layout.kdl ahead of this setting, so
// `zellij attach --create <name>` on a name that existed before this line was added comes
// back with the old tab-bar/status-bar pair and never picks up compact. Verified by planting
// a tab-bar session-layout.kdl under a fresh name: it resurrected tab-bar, config ignored.
// To convert such a session, discard its saved state with `zellij delete-session --force
// <name>` and recreate it -- that drops its remembered panes and cwds.
default_layout "compact"
show_startup_tips false

// A floating plugin pane only receives keyboard input while zellij is in locked mode
// (zellij-org/zellij#4599), so the stock "SwitchToMode normal" ending each of these binds
// leaves the session manager mouse-only -- it opens, it takes clicks, and it ignores the
// keyboard. Landing back in locked is what lets typing reach the plugin. These are the only
// keybinds overridden, so no clear-defaults here: everything else stays zellij's default.
keybinds {
    session {
        bind "a" {
            LaunchOrFocusPlugin "zellij:about" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "s" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
    }
}
